{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Localized, voice-driven Agentic OS — HUD + routing engine + headless claude -p skills + Obsidian memory.",
  "workspaces": [
    "packages/*",
    "services/gateway",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w @aos/gateway",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run start -w @aos/gateway",
    "hud": "npm run dev -w @aos/hud",
    "route-demo": "npm run route-demo -w @aos/gateway",
    "runtime-demo": "npm run runtime-demo -w @aos/gateway",
    "vault-demo": "npm run vault-demo -w @aos/gateway",
    "deck-demo": "npm run deck-demo -w @aos/gateway",
    "research-demo": "npm run research-demo -w @aos/gateway",
    "voice-demo": "npm run voice-demo -w @aos/gateway",
    "mail-demo": "npm run mail-demo -w @aos/gateway",
    "mail-auth-demo": "npm run mail-auth-demo -w @aos/gateway",
    "config-demo": "npm run config-demo -w @aos/gateway",
    "embed": "node scripts/embed.mjs",
    "prebuild:app": "npm run build -w @aos/hud && npm run embed",
    "build:app": "bun build services/gateway/src/server.ts --compile --minify --outfile dist/aos",
    "build:app:win": "bun build services/gateway/src/server.ts --compile --minify --target=bun-windows-x64 --outfile dist/aos-win-x64.exe",
    "build:app:mac": "bun build services/gateway/src/server.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/aos-mac-arm64",
    "build:app:mac-intel": "bun build services/gateway/src/server.ts --compile --minify --target=bun-darwin-x64 --outfile dist/aos-mac-x64",
    "build:app:linux": "bun build services/gateway/src/server.ts --compile --minify --target=bun-linux-x64 --outfile dist/aos-linux-x64"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
