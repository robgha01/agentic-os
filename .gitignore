.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class

# Voice sidecar generated audio
services/voice/.audio/
.venv/
venv/
env/
.pytest_cache/

# Build output
dist/
build/
*.log

# Env
.env
.env.local
.env.*.local

# Brainstorming companion (visual mockups)
.superpowers/

# Planning screenshots (the prompt text stays tracked)
planing/*.png

# Vault data must never live under a package dir (vault is repo-root only)
services/*/vault/

# Agentic OS task scratch + coordination state (ephemeral)
.agentic-os/tasks/
.agentic-os/state/

# Vault: generated records are user data, not source. Keep only the structural
# seeds (conventions, schema, templates, maps) under version control.
vault/**
!vault/.gitkeep
!vault/_meta/
!vault/_meta/**
!vault/_templates/
!vault/_templates/**
!vault/90-maps/
!vault/90-maps/**
planing/notificationboxes.txt
planing/vaultreference.txt
planing/yamlandother.txt
