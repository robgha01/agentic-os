{
  "id": "inbox-triage",
  "name": "Inbox Triage",
  "description": "Fetches unread mail (Outlook / Microsoft 365 via Graph; provider configurable) and compiles a triage record — counts, likely-needs-reply action items, and a by-sender overview — into the vault.",
  "triggers": ["inbox-triage"],
  "surfaces": ["deck", "nl"],
  "presentation": {
    "label": "Triage Inbox",
    "icon": "inbox",
    "group": "Workflows",
    "inputs": [
      { "name": "force", "type": "boolean", "label": "Force refresh", "default": false }
    ]
  },
  "modelPolicy": {
    "execTier": "none",
    "privacy": "local-only"
  },
  "execution": {
    "kind": "native",
    "handler": "inboxTriage"
  },
  "vaultOutput": "02-inbox/{{date}}.md",
  "staleAfterMinutes": 60,
  "produces": { "type": "inbox", "keyDate": true }
}
