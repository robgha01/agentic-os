{
  "id": "last-30-days",
  "name": "Last 30 Days Deep Research",
  "description": "Gathers high-signal recent activity on a topic and compiles a cited research brief into the vault. Phase 3a sources Hacker News; more sources (Reddit, YouTube, X) are added as sub-skills.",
  "triggers": ["last-30-days"],
  "surfaces": ["deck", "nl"],
  "presentation": {
    "label": "Deep Research",
    "icon": "telescope",
    "group": "Knowledge",
    "inputs": [
      { "name": "topic", "type": "string", "label": "Topic", "required": true },
      { "name": "force", "type": "boolean", "label": "Force refresh", "default": false }
    ]
  },
  "modelPolicy": {
    "execTier": "heavy",
    "privacy": "cloud-ok"
  },
  "execution": {
    "kind": "composite",
    "steps": ["fetch-hackernews", "fetch-reddit", "synthesize-research", "compile-research"]
  },
  "vaultOutput": "10-research/{{topic}}.md",
  "staleAfterMinutes": 1440,
  "produces": { "type": "research", "keyParam": "topic" }
}
